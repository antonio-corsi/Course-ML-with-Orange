		<properties node_id="28" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x05\xf4\x00\x00\x02\xdf\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde\x00\x00\x00\x00\x02\x00\x00\x00\x05\xf4\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde', 'select_rows': False, 'show_attribute_labels': True, 'show_distributions': True, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="29" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x01q\x00\x00\x00_\x00\x00\x04\x93\x00\x00\x02^\x00\x00\x01r\x00\x00\x00~\x00\x00\x04\x92\x00\x00\x02]\x00\x00\x00\x00\x00\x00\x00\x00\x05\xf4\x00\x00\x01r\x00\x00\x00~\x00\x00\x04\x92\x00\x00\x02]', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '"""Pearson correlation matrix and coolwarm heatmap for Orange Python Script."""\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom Orange.data import Domain, Table, ContinuousVariable, StringVariable\n\n# Settings\nMETHOD = "pearson"          # Change to "spearman" for rank correlations.\nDECIMALS = 2\nMIN_PAIRS = 3               # Minimum jointly observed rows for each pair.\nINCLUDE_TARGET = True      # Include numeric target variables.\nINCLUDE_METAS = False      # Numeric metas may contain identifiers.\nFIGURE_NAME = "Orange - Correlation matrix"\n\n\ndef plot_correlation(corr):\n    """Display a full correlation matrix in a separate window."""\n    names = corr.columns.tolist()\n    values = corr.to_numpy()\n    n = len(names)\n\n    cmap = plt.get_cmap("coolwarm").copy()\n    cmap.set_bad("#eeeeee")  # Undefined correlations appear in light grey.\n\n    fig, ax = plt.subplots(\n        num=FIGURE_NAME,\n        figsize=(max(9, 0.65 * n + 4), max(8, 0.65 * n + 3)),\n        dpi=110,\n        constrained_layout=True,\n    )\n\n    image = ax.imshow(\n        np.ma.masked_invalid(values),\n        cmap=cmap,\n        vmin=-1,\n        vmax=1,\n        interpolation="nearest",\n        aspect="equal",\n    )\n\n    ax.set_xticks(np.arange(n))\n    ax.set_yticks(np.arange(n))\n    ax.set_xticklabels(names, rotation=45, ha="right", fontsize=9)\n    ax.set_yticklabels(names, fontsize=9)\n\n    # White gridlines separate the cells.\n    ax.set_xticks(np.arange(n + 1) - 0.5, minor=True)\n    ax.set_yticks(np.arange(n + 1) - 0.5, minor=True)\n    ax.grid(which="minor", color="white", linewidth=0.7)\n    ax.tick_params(which="minor", bottom=False, left=False)\n    for spine in ax.spines.values():\n        spine.set_visible(False)\n\n    # Annotate each cell without rounding the underlying matrix.\n    font_size = max(6, min(11, 120 / n))\n    for i in range(n):\n        for j in range(n):\n            value = values[i, j]\n            if np.isfinite(value):\n                displayed = 0.0 if abs(value) &lt; 0.5 * 10**(-DECIMALS) else value\n                label = f"{displayed:.{DECIMALS}f}"\n                colour = "white" if abs(value) &gt;= 0.7 else "#202020"\n            else:\n                label = "NA"\n                colour = "#777777"\n            ax.text(j, i, label, ha="center", va="center",\n                    fontsize=font_size, color=colour)\n\n    ax.set_title(f"{METHOD.capitalize()} correlation matrix", pad=18)\n    colourbar = fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04)\n    colourbar.set_label("Correlation coefficient")\n    colourbar.set_ticks([-1, -0.5, 0, 0.5, 1])\n\n    # Orange already has a GUI event loop.\n    plt.show(block=False)\n\n\n# Reset outputs and replace only this script\'s previous figure.\nout_data = None\nout_object = None\nplt.close(FIGURE_NAME)\n\nif in_data is None:\n    print("Connect a dataset to the Python Script widget.")\nelif len(in_data) &lt; MIN_PAIRS:\n    print(f"At least {MIN_PAIRS} data rows are required.")\nelse:\n    variables = list(in_data.domain.attributes)\n    if INCLUDE_TARGET:\n        variables.extend(in_data.domain.class_vars)\n    if INCLUDE_METAS:\n        variables.extend(in_data.domain.metas)\n\n    # Exclude categorical codes, text, and date/time variables.\n    variables = [\n        var for var in variables\n        if var.is_continuous and not var.is_time\n    ]\n\n    if len(variables) &lt; 2:\n        print("At least two numeric variables are required.")\n    else:\n        names = [var.name for var in variables]\n        matrix = np.column_stack([\n            np.asarray(in_data.get_column(var), dtype=float)\n            for var in variables\n        ])\n\n        df = pd.DataFrame(matrix, columns=names)\n        df = df.replace([np.inf, -np.inf], np.nan)\n\n        # Each pair uses rows where both variables have valid values.\n        corr = df.corr(method=METHOD, min_periods=MIN_PAIRS)\n\n        # Send the numeric matrix to Orange\'s Data output.\n        row_label = "Row variable"\n        while row_label in names:\n            row_label += "_"\n\n        domain = Domain(\n            [ContinuousVariable(name, number_of_decimals=DECIMALS)\n             for name in names],\n            metas=[StringVariable(row_label)],\n        )\n        out_data = Table.from_numpy(\n            domain,\n            X=corr.to_numpy(),\n            metas=np.asarray(names, dtype=object).reshape(-1, 1),\n        )\n        out_data.name = f"{METHOD.capitalize()} correlation matrix"\n\n        # The Object output also contains the pandas DataFrame.\n        out_object = corr\n\n        print(corr.to_string(float_format=lambda x: f"{x:.{DECIMALS}f}"))\n        print("\\nData output: correlation matrix. Grey / NA: undefined.")\n        plot_correlation(corr)\n\n"""Pearson correlation matrix and coolwarm heatmap for Orange Python Script."""\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom Orange.data import Domain, Table, ContinuousVariable, StringVariable\n\n# Settings\nMETHOD = "pearson"          # Change to "spearman" for rank correlations.\nDECIMALS = 2\nMIN_PAIRS = 3               # Minimum jointly observed rows for each pair.\nINCLUDE_TARGET = True      # Include numeric target variables.\nINCLUDE_METAS = False      # Numeric metas may contain identifiers.\nFIGURE_NAME = "Orange - Correlation matrix"\n\n\ndef plot_correlation(corr):\n    """Display a full correlation matrix in a separate window."""\n    names = corr.columns.tolist()\n    values = corr.to_numpy()\n    n = len(names)\n\n    cmap = plt.get_cmap("coolwarm").copy()\n    cmap.set_bad("#eeeeee")  # Undefined correlations appear in light grey.\n\n    fig, ax = plt.subplots(\n        num=FIGURE_NAME,\n        figsize=(max(9, 0.65 * n + 4), max(8, 0.65 * n + 3)),\n        dpi=110,\n        constrained_layout=True,\n    )\n\n    image = ax.imshow(\n        np.ma.masked_invalid(values),\n        cmap=cmap,\n        vmin=-1,\n        vmax=1,\n        interpolation="nearest",\n        aspect="equal",\n    )\n\n    ax.set_xticks(np.arange(n))\n    ax.set_yticks(np.arange(n))\n    ax.set_xticklabels(names, rotation=45, ha="right", fontsize=9)\n    ax.set_yticklabels(names, fontsize=9)\n\n    # White gridlines separate the cells.\n    ax.set_xticks(np.arange(n + 1) - 0.5, minor=True)\n    ax.set_yticks(np.arange(n + 1) - 0.5, minor=True)\n    ax.grid(which="minor", color="white", linewidth=0.7)\n    ax.tick_params(which="minor", bottom=False, left=False)\n    for spine in ax.spines.values():\n        spine.set_visible(False)\n\n    # Annotate each cell without rounding the underlying matrix.\n    font_size = max(6, min(11, 120 / n))\n    for i in range(n):\n        for j in range(n):\n            value = values[i, j]\n            if np.isfinite(value):\n                displayed = 0.0 if abs(value) &lt; 0.5 * 10**(-DECIMALS) else value\n                label = f"{displayed:.{DECIMALS}f}"\n                colour = "white" if abs(value) &gt;= 0.7 else "#202020"\n            else:\n                label = "NA"\n                colour = "#777777"\n            ax.text(j, i, label, ha="center", va="center",\n                    fontsize=font_size, color=colour)\n\n    ax.set_title(f"{METHOD.capitalize()} correlation matrix", pad=18)\n    colourbar = fig.colorbar(image, ax=ax, fraction=0.046, pad=0.04)\n    colourbar.set_label("Correlation coefficient")\n    colourbar.set_ticks([-1, -0.5, 0, 0.5, 1])\n\n    # Orange already has a GUI event loop.\n    plt.show(block=False)\n\n\n# Reset outputs and replace only this script\'s previous figure.\nout_data = None\nout_object = None\nplt.close(FIGURE_NAME)\n\nif in_data is None:\n    print("Connect a dataset to the Python Script widget.")\nelif len(in_data) &lt; MIN_PAIRS:\n    print(f"At least {MIN_PAIRS} data rows are required.")\nelse:\n    variables = list(in_data.domain.attributes)\n    if INCLUDE_TARGET:\n        variables.extend(in_data.domain.class_vars)\n    if INCLUDE_METAS:\n        variables.extend(in_data.domain.metas)\n\n    # Exclude categorical codes, text, and date/time variables.\n    variables = [\n        var for var in variables\n        if var.is_continuous and not var.is_time\n    ]\n\n    if len(variables) &lt; 2:\n        print("At least two numeric variables are required.")\n    else:\n        names = [var.name for var in variables]\n        matrix = np.column_stack([\n            np.asarray(in_data.get_column(var), dtype=float)\n            for var in variables\n        ])\n\n        df = pd.DataFrame(matrix, columns=names)\n        df = df.replace([np.inf, -np.inf], np.nan)\n\n        # Each pair uses rows where both variables have valid values.\n        corr = df.corr(method=METHOD, min_periods=MIN_PAIRS)\n\n        # Send the numeric matrix to Orange\'s Data output.\n        row_label = "Row variable"\n        while row_label in names:\n            row_label += "_"\n\n        domain = Domain(\n            [ContinuousVariable(name, number_of_decimals=DECIMALS)\n             for name in names],\n            metas=[StringVariable(row_label)],\n        )\n        out_data = Table.from_numpy(\n            domain,\n            X=corr.to_numpy(),\n            metas=np.asarray(names, dtype=object).reshape(-1, 1),\n        )\n        out_data.name = f"{METHOD.capitalize()} correlation matrix"\n\n        # The Object output also contains the pandas DataFrame.\n        out_object = corr\n\n        print(corr.to_string(float_format=lambda x: f"{x:.{DECIMALS}f}"))\n        print("\\nData output: correlation matrix. Grey / NA: undefined.")\n        plot_correlation(corr)\n\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
