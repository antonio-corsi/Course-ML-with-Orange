		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x05\xf4\x00\x00\x02\xdf\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde\x00\x00\x00\x00\x02\x00\x00\x00\x05\xf4\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '"""Standard deviation per numeric column in Orange\'s Python Script widget."""\n\nimport numpy as np\nfrom Orange.data import Domain, Table, ContinuousVariable, StringVariable\n\nout_data = None\n\nif in_data is None:\n    print("Connect a dataset to the Python Script widget.")\nelse:\n    statistics = []\n    variable_info = []\n\n    # Include numeric features, targets, and metas.\n    groups = [\n        ("Feature", in_data.domain.attributes),\n        ("Target", in_data.domain.class_vars),\n        ("Meta", in_data.domain.metas),\n    ]\n\n    for role, variables in groups:\n        for variable in variables:\n            # Skip categorical, text, and date/time variables.\n            if not variable.is_continuous or variable.is_time:\n                continue\n\n            values = np.asarray(in_data.get_column(variable), dtype=float)\n\n            # Exclude missing values (NaN) and positive/negative infinity.\n            valid = values[np.isfinite(values)]\n            n = valid.size\n            excluded = values.size - n\n\n            # Avoid warnings when there are too few valid observations.\n            sample_sd = np.std(valid, ddof=1) if n &gt; 1 else np.nan\n            population_sd = np.std(valid, ddof=0) if n &gt; 0 else np.nan\n\n            statistics.append([n, excluded, sample_sd, population_sd])\n            variable_info.append([variable.name, role])\n\n            print(\n                f"{variable.name} ({role}): N={n}, excluded={excluded}, "\n                f"sample SD={sample_sd:.6g}, population SD={population_sd:.6g}"\n            )\n\n    if statistics:\n        # One output row per numeric input variable.\n        output_domain = Domain(\n            attributes=[\n                ContinuousVariable("N valid", number_of_decimals=0),\n                ContinuousVariable("N excluded", number_of_decimals=0),\n                ContinuousVariable("Sample SD", number_of_decimals=6),\n                ContinuousVariable("Population SD", number_of_decimals=6),\n            ],\n            metas=[\n                StringVariable("Variable"),\n                StringVariable("Role"),\n            ],\n        )\n\n        out_data = Table.from_numpy(\n            output_domain,\n            X=np.asarray(statistics, dtype=float),\n            metas=np.asarray(variable_info, dtype=object),\n        )\n        out_data.name = "Standard deviations"\n\n        print("\\nConnect the Data output to a Data Table widget.")\n    else:\n        print("No numeric columns found (date/time columns are excluded).")\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
