		<properties node_id="23" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x05\xf4\x00\x00\x02\xdf\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde\x00\x00\x00\x00\x02\x00\x00\x00\x05\xf4\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x05\xf3\x00\x00\x02\xde', 'scriptLibrary': [{'name': 'Table from numpy', 'script': 'import numpy as np\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable\n\ndomain = Domain([ContinuousVariable("age"),\n                 ContinuousVariable("height"),\n                 DiscreteVariable("gender", values=("M", "F"))])\narr = np.array([\n  [25, 186, 0],\n  [30, 164, 1]])\nout_data = Table.from_numpy(domain, arr)\n', 'filename': None}], 'scriptText': '"""Orange Python Script: interactive missing-value counts and cell inspection."""\n\nfrom pathlib import Path\nimport tempfile\n\nimport numpy as np\nimport pandas as pd\nimport plotly.express as px\nfrom plotly.subplots import make_subplots\nfrom Orange.data import ContinuousVariable, Domain, StringVariable, Table\n\n# SETTINGS\nINCLUDE_TARGETS = True\nINCLUDE_METAS = True\nID_COLUMN = None           # For example: "id" or "customer_id".\n                          # None uses Orange\'s internal row IDs.\nOPEN_BROWSER = True\nPRESENT_COLOR = "#E8EEF0"\nMISSING_COLOR = "#D45D48"\n\n# This installs a real click handler in the exported HTML report.\nCLICK_HANDLER = r"""\nconst plot = document.getElementById(\'{plot_id}\');\nconst info = document.createElement(\'div\');\ninfo.id = \'mv-selection\';\ninfo.setAttribute(\'role\', \'status\');\ninfo.style.cssText = \'position:sticky;top:0;z-index:1000;padding:14px 20px;\'\n    + \'margin:12px;border:2px solid #D45D48;border-radius:8px;\'\n    + \'background:white;color:#253943;font:16px Arial,sans-serif;\';\ninfo.textContent = \'Click a red cell below to identify its row and column.\';\nplot.parentNode.insertBefore(info, plot);\n\nplot.on(\'plotly_click\', function(event) {\n    const point = event.points[0];\n    if (point.data.type !== \'heatmap\') return;\n    const missing = Number(point.z) === 1;\n    const row = Number(point.y);\n    const id = point.customdata[0];\n    const orangeId = point.customdata[1];\n    info.textContent = (missing ? \'MISSING VALUE\' : \'Observed value\')\n        + \' | Row ID: \' + id\n        + \' | Input row: \' + row\n        + \' | Orange ID: \' + orangeId\n        + \' | Column: \' + point.x;\n    info.style.borderColor = missing ? \'#D45D48\' : \'#356A75\';\n    Plotly.relayout(plot, {shapes: [{\n        type: \'rect\', xref: \'x2 domain\', yref: \'y2\',\n        x0: 0, x1: 1, y0: row - 0.5, y1: row + 0.5,\n        line: {color: \'#183943\', width: 2},\n        fillcolor: \'rgba(0,0,0,0)\', layer: \'above\'\n    }]});\n});\n"""\n\n\ndef missing_values_report(data):\n    variables = list(data.domain.attributes)\n    if INCLUDE_TARGETS:\n        variables += list(data.domain.class_vars)\n    if INCLUDE_METAS:\n        variables += list(data.domain.metas)\n    if not variables:\n        raise ValueError("There are no columns to inspect.")\n\n    names = [var.name for var in variables]\n    n_rows, n_cols = len(data), len(variables)\n    missing = np.zeros((n_rows, n_cols), dtype=bool)\n\n    # Detect actual missing values without changing the input table.\n    for j, var in enumerate(variables):\n        column = data.get_column(var)\n        if var.is_string:\n            empty = np.fromiter(\n                (isinstance(value, str) and value == "" for value in column),\n                dtype=bool, count=n_rows,\n            )\n            missing[:, j] = pd.isna(column) | empty\n        else:\n            # Includes numeric, categorical and time variables.\n            missing[:, j] = np.isnan(np.asarray(column, dtype=float))\n\n    input_rows = np.arange(1, n_rows + 1)\n    orange_ids = np.asarray(data.ids, dtype=str)\n    if ID_COLUMN is None:\n        row_ids = orange_ids.copy()\n        id_description = "Orange internal ID"\n    else:\n        id_var = data.domain[ID_COLUMN]\n        row_ids = np.array(\n            [id_var.str_val(value) for value in data.get_column(id_var)],\n            dtype=object,\n        )\n        id_description = str(ID_COLUMN)\n\n    counts = missing.sum(axis=0)\n    row_counts = missing.sum(axis=1)\n    summary = pd.DataFrame({\n        "Column": names,\n        "Missing": counts,\n        "Missing (%)": 100 * counts / n_rows,\n    })\n\n    # TOP: counts are printed above the bars; percentages remain in hover.\n    bars = px.bar(\n        summary, x="Column", y="Missing", text="Missing",\n        custom_data=["Missing (%)"],\n        color_discrete_sequence=[MISSING_COLOR],\n    )\n    bars.update_traces(\n        texttemplate="%{y:,d}", textposition="outside", cliponaxis=False,\n        hovertemplate="&lt;b&gt;%{x}&lt;/b&gt;&lt;br&gt;Missing: %{y:,d}"\n                      "&lt;br&gt;Missing: %{customdata[0]:.2f}%&lt;extra&gt;&lt;/extra&gt;",\n    )\n\n    # BOTTOM: 0 = observed; 1 = missing. Keep every row in input order.\n    heatmap = px.imshow(\n        missing.astype(np.uint8), x=names, y=input_rows,\n        zmin=0, zmax=1, aspect="auto", origin="upper",\n        binary_string=False,\n    )\n    customdata = np.empty((n_rows, n_cols, 2), dtype=object)\n    customdata[:, :, 0] = row_ids[:, None]\n    customdata[:, :, 1] = orange_ids[:, None]\n    heatmap.update_traces(\n        customdata=customdata, zsmooth=False,\n        hovertemplate="&lt;b&gt;%{x}&lt;/b&gt;&lt;br&gt;Row ID: %{customdata[0]}"\n                      "&lt;br&gt;Input row: %{y}&lt;br&gt;Orange ID: %{customdata[1]}"\n                      "&lt;br&gt;Missing flag: %{z} (1 = missing)"\n                      "&lt;extra&gt;Click to pin details&lt;/extra&gt;",\n    )\n\n    fig = make_subplots(\n        rows=2, cols=1, shared_xaxes=True,\n        row_heights=[0.28, 0.72], vertical_spacing=0.10,\n        subplot_titles=("Missing values by column: counts",\n                        "Missing-value map: click a red cell"),\n    )\n    fig.add_trace(bars.data[0], row=1, col=1)\n    fig.add_trace(heatmap.data[0], row=2, col=1)\n    fig.update_layout(\n        title=f"Missing values | {n_rows:,} rows | {int(counts.sum()):,} missing cells",\n        template="plotly_white", height=950, showlegend=False,\n        margin=dict(l=85, r=115, t=100, b=150),\n        font=dict(family="Arial", size=13, color="#253943"),\n        hovermode="closest", clickmode="event", dragmode="zoom",\n        coloraxis=dict(\n            cmin=0, cmax=1,\n            colorscale=[[0, PRESENT_COLOR], [0.5, PRESENT_COLOR],\n                        [0.5, MISSING_COLOR], [1, MISSING_COLOR]],\n            colorbar=dict(title="Cell status", tickvals=[0, 1],\n                          ticktext=["Observed", "Missing"], len=0.45, y=0.35),\n        ),\n    )\n    fig.update_xaxes(type="category", categoryorder="array", categoryarray=names)\n    fig.update_xaxes(showticklabels=False, row=1, col=1)\n    fig.update_xaxes(title_text="Column", tickangle=-35, row=2, col=1)\n    fig.update_yaxes(title_text="Number of MVs", tickformat=",d",\n                     dtick=1 if counts.max() &lt;= 10 else None,\n                     range=[0, max(1, int(counts.max())) * 1.2], row=1, col=1)\n    fig.update_yaxes(title_text="Input row (1-based)", autorange="reversed",\n                     dtick=1 if n_rows &lt;= 20 else None,\n                     tickformat="d", row=2, col=1)\n\n    # Output an Orange table of 0/1 indicators, retaining source row IDs.\n    domain = Domain(\n        [ContinuousVariable("MV: " + name, number_of_decimals=0) for name in names],\n        metas=[ContinuousVariable("Input row", number_of_decimals=0),\n               StringVariable("Row ID"),\n               ContinuousVariable("Missing count", number_of_decimals=0)],\n    )\n    metas = np.empty((n_rows, 3), dtype=object)\n    metas[:, 0], metas[:, 1], metas[:, 2] = input_rows, row_ids, row_counts\n    result = Table.from_numpy(\n        domain, missing.astype(float), metas=metas,\n        W=data.W.copy(), ids=data.ids.copy(),\n    )\n    result.name = "Missing-value indicators"\n\n    # Each run creates a separate, self-contained local HTML report.\n    with tempfile.NamedTemporaryFile(\n        prefix="orange_missing_values_", suffix=".html", delete=False\n    ) as temporary_file:\n        html_file = Path(temporary_file.name)\n    fig.write_html(\n        str(html_file), include_plotlyjs=True, full_html=True,\n        post_script=CLICK_HANDLER, auto_open=OPEN_BROWSER,\n        config={"responsive": True, "scrollZoom": True, "displaylogo": False},\n    )\n    print(summary.to_string(index=False, float_format=lambda value: f"{value:.2f}"))\n    print(f"\\nRows with at least one MV: {int((row_counts &gt; 0).sum()):,} / {n_rows:,}")\n    print(f"Row ID source: {id_description}")\n    print(f"Interactive report: {html_file}")\n    return result, {"summary": summary, "figure": fig, "html_file": str(html_file)}\n\nout_data = None\nout_object = None\nif in_data is None or len(in_data) == 0:\n    print("Connect a non-empty dataset to this Python Script widget.")\nelse:\n    out_data, out_object = missing_values_report(in_data)', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
