		<properties node_id="10" format="literal">{'controlAreaVisible': True, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07', 'scriptLibrary': [{'name': 'p-value coefficienti', 'script': '# p-value dei coefficienti della regressione lineare (OLS)\n# Rifacciamo con numpy lo stesso fit del widget Linear Regression e calcoliamo\n# errore standard, statistica t e p-value di ogni coefficiente.\n# Le variabili categoriche sono codificate con una dummy per livello meno il primo,\n# che fa da livello base (es. citta=Bari): stessa retta di regressione, ma i\n# coefficienti delle dummy vanno letti come differenza rispetto al livello base.\nimport numpy as np\nfrom scipy import stats\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\nfrom Orange.preprocess import Continuize\n\nif in_data is None:\n    raise ValueError("Collegare i dati di training all\'ingresso Data")\n\n# 1) matrice del disegno: dummy con livello base + colonna di 1 per l\'intercetta\ndati = Continuize(multinomial_treatment=Continuize.FirstAsBase)(in_data)\nX = np.asarray(dati.X, dtype=float)\ny = np.asarray(dati.Y, dtype=float).ravel()\ncomplete = ~np.isnan(X).any(axis=1) &amp; ~np.isnan(y)\nX, y = X[complete], y[complete]\nX1 = np.column_stack([np.ones(len(X)), X])\ntermini = ["intercetta"] + [v.name for v in dati.domain.attributes]\n\n# 2) stima OLS e inferenza sui coefficienti\nbeta, *_ = np.linalg.lstsq(X1, y, rcond=None)\nn, p = X1.shape\ngdl = n - p                                   # gradi di liberta\' dei residui\nresidui = y - X1 @ beta\nrss = residui @ residui\nsigma2 = rss / gdl                            # varianza residua stimata\ncov_beta = sigma2 * np.linalg.pinv(X1.T @ X1) # covarianza dei coefficienti\nerr_std = np.sqrt(np.diag(cov_beta))\nt = beta / err_std\np_value = 2 * stats.t.sf(np.abs(t), gdl)      # test bilaterale H0: coefficiente = 0\n\n# 3) riepilogo del modello nella console\ntss = ((y - y.mean()) ** 2).sum()\nr2 = 1 - rss / tss\nr2_adj = 1 - (1 - r2) * (n - 1) / gdl\nf = ((tss - rss) / (p - 1)) / (rss / gdl)\nprint(f"n = {n}, coefficienti = {p} (intercetta inclusa), gdl residui = {gdl}")\nprint(f"R2 = {r2:.4f}   R2 corretto = {r2_adj:.4f}   RMSE in-sample = {np.sqrt(rss / n):,.0f}")\nprint(f"test F sul modello: F = {f:,.1f}, p-value = {stats.f.sf(f, p - 1, gdl):.3g}")\nprint(f"coefficienti con p-value &lt; 0.05: {(p_value &lt; 0.05).sum()} su {p}")\n\n# 4) tabella in uscita (Data): una riga per coefficiente, stelle come in R\ncodice = np.select([p_value &lt; 0.001, p_value &lt; 0.01, p_value &lt; 0.05, p_value &lt; 0.1],\n                   [4, 3, 2, 1], default=0)\ndominio = Domain([ContinuousVariable("coef"),\n                  ContinuousVariable("err_std"),\n                  ContinuousVariable("t", number_of_decimals=2),\n                  ContinuousVariable("p_value", number_of_decimals=4),\n                  DiscreteVariable("signif", values=["n.s.", ".", "*", "**", "***"])],\n                 metas=[StringVariable("termine")])\nout_data = Table.from_numpy(dominio,\n                            np.column_stack([beta, err_std, t, p_value, codice]),\n                            metas=np.array(termini, dtype=object).reshape(-1, 1))\n', 'filename': None}], 'scriptText': '# p-value dei coefficienti della regressione lineare (OLS)\n# Rifacciamo con numpy lo stesso fit del widget Linear Regression e calcoliamo\n# errore standard, statistica t e p-value di ogni coefficiente.\n# Le variabili categoriche sono codificate con una dummy per livello meno il primo,\n# che fa da livello base (es. citta=Bari): stessa retta di regressione, ma i\n# coefficienti delle dummy vanno letti come differenza rispetto al livello base.\nimport numpy as np\nfrom scipy import stats\nfrom Orange.data import Table, Domain, ContinuousVariable, DiscreteVariable, StringVariable\nfrom Orange.preprocess import Continuize\n\nif in_data is None:\n    raise ValueError("Collegare i dati di training all\'ingresso Data")\n\n# 1) matrice del disegno: dummy con livello base + colonna di 1 per l\'intercetta\ndati = Continuize(multinomial_treatment=Continuize.FirstAsBase)(in_data)\nX = np.asarray(dati.X, dtype=float)\ny = np.asarray(dati.Y, dtype=float).ravel()\ncomplete = ~np.isnan(X).any(axis=1) &amp; ~np.isnan(y)\nX, y = X[complete], y[complete]\nX1 = np.column_stack([np.ones(len(X)), X])\ntermini = ["intercetta"] + [v.name for v in dati.domain.attributes]\n\n# 2) stima OLS e inferenza sui coefficienti\nbeta, *_ = np.linalg.lstsq(X1, y, rcond=None)\nn, p = X1.shape\ngdl = n - p                                   # gradi di liberta\' dei residui\nresidui = y - X1 @ beta\nrss = residui @ residui\nsigma2 = rss / gdl                            # varianza residua stimata\ncov_beta = sigma2 * np.linalg.pinv(X1.T @ X1) # covarianza dei coefficienti\nerr_std = np.sqrt(np.diag(cov_beta))\nt = beta / err_std\np_value = 2 * stats.t.sf(np.abs(t), gdl)      # test bilaterale H0: coefficiente = 0\n\n# 3) riepilogo del modello nella console\ntss = ((y - y.mean()) ** 2).sum()\nr2 = 1 - rss / tss\nr2_adj = 1 - (1 - r2) * (n - 1) / gdl\nf = ((tss - rss) / (p - 1)) / (rss / gdl)\nprint(f"n = {n}, coefficienti = {p} (intercetta inclusa), gdl residui = {gdl}")\nprint(f"R2 = {r2:.4f}   R2 corretto = {r2_adj:.4f}   RMSE in-sample = {np.sqrt(rss / n):,.0f}")\nprint(f"test F sul modello: F = {f:,.1f}, p-value = {stats.f.sf(f, p - 1, gdl):.3g}")\nprint(f"coefficienti con p-value &lt; 0.05: {(p_value &lt; 0.05).sum()} su {p}")\n\n# 4) tabella in uscita (Data): una riga per coefficiente, stelle come in R\ncodice = np.select([p_value &lt; 0.001, p_value &lt; 0.01, p_value &lt; 0.05, p_value &lt; 0.1],\n                   [4, 3, 2, 1], default=0)\ndominio = Domain([ContinuousVariable("coef"),\n                  ContinuousVariable("err_std"),\n                  ContinuousVariable("t", number_of_decimals=2),\n                  ContinuousVariable("p_value", number_of_decimals=4),\n                  DiscreteVariable("signif", values=["n.s.", ".", "*", "**", "***"])],\n                 metas=[StringVariable("termine")])\nout_data = Table.from_numpy(dominio,\n                            np.column_stack([beta, err_std, t, p_value, codice]),\n                            metas=np.array(termini, dtype=object).reshape(-1, 1))\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
		<properties node_id="11" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07t\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07\x00\x00\x00\x00\x02\x00\x00\x00\x07t\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07s\x00\x00\x04\x07', 'select_rows': True, 'selected_cols': [], 'selected_rows': [], 'show_attribute_labels': True, 'show_distributions': True, '__version__': 2}</properties>
		<properties node_id="12" format="literal">{'auto_commit': True, 'color_by_class': True, 'controlAreaVisible': True, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\x00\x00\x00\x06\x00\x00\x005\x00\x00\x07{\x00\x00\x03\xfa\x00\x00\x00\x07\x00\x00\x00T\x00\x00\x07z\x00\x00\x03\xf9\x00\x00\x00\x00\x00\x00\x00\x00\x07\x80\x00\x00\x00\x07\x00\x00\x00T\x00\x00\x07z\x00\x00\x03\xf9', 'select_rows': True, 'show_attribute_labels': True, 'show_distributions': False, 'stored_selection': {'rows': [], 'columns': []}, 'stored_sort': [], '__version__': 1}</properties>
		<properties node_id="13" format="literal">{'controlAreaVisible': False, 'currentScriptIndex': 0, 'savedWidgetGeometry': b'\x01\xd9\xd0\xcb\x00\x03\x00\x00\xff\xff\xff\xff\xff\xff\xff\xf8\x00\x00\x07\x80\x00\x00\x04\x10\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f\x00\x00\x00\x00\x02\x00\x00\x00\x07\x80\x00\x00\x00\x00\x00\x00\x00\x17\x00\x00\x07\x7f\x00\x00\x04\x0f', 'scriptLibrary': [{'name': 'matrice di correlazione', 'script': '# Matrice di correlazione tra i predittori (+ risposta prezzo_vendita)\n# Da incollare nel widget "Python Script" di Orange Data Mining.\n# Input:  in_data  -&gt; la tabella caricata con il widget File (alloggi_vendita.csv)\n# Output: out_data -&gt; la matrice di correlazione come tabella Orange (collegabile a Data Table)\n\nimport matplotlib.pyplot as plt\nfrom Orange.data.pandas_compat import table_to_frame, table_from_frame\n\n# --- Impostazioni -----------------------------------------------------------\nINCLUDI_BINARIE = True   # converte le variabili si/no in 0/1 (correlazione punto-biseriale)\nMETODO = "pearson"       # "spearman" per relazioni monotone non lineari\n# ---------------------------------------------------------------------------\n\ndf = table_to_frame(in_data, include_metas=False)\n\n# Selezioniamo le variabili numeriche del dominio (tipo "continuous")\nnumeriche = [v.name for v in in_data.domain.variables if v.is_continuous]\ncolonne = df[numeriche].copy()\n\n# Le variabili discrete si/no le ricodifichiamo in 0/1\nif INCLUDI_BINARIE:\n    for v in in_data.domain.variables:\n        if v.is_discrete and set(v.values) == {"si", "no"}:\n            colonne[v.name] = (df[v.name].astype(str) == "si").astype(int)\n\n# Spostiamo la risposta in fondo alla matrice\ntarget = in_data.domain.class_var.name if in_data.domain.class_var else "prezzo_vendita"\ncolonne = colonne[[c for c in colonne.columns if c != target] + [target]]\n\ncorr = colonne.corr(method=METODO)\n\n# --- Heatmap ----------------------------------------------------------------\nn = len(corr)\nfig, ax = plt.subplots(figsize=(0.7 * n + 3, 0.7 * n + 2))\nim = ax.imshow(corr.values, cmap="coolwarm", vmin=-1, vmax=1)\nax.set_xticks(range(n))\nax.set_xticklabels(corr.columns, rotation=45, ha="right")\nax.set_yticks(range(n))\nax.set_yticklabels(corr.index)\nfor i in range(n):\n    for j in range(n):\n        val = corr.values[i, j]\n        ax.text(j, i, f"{val:.2f}", ha="center", va="center", fontsize=8,\n                color="white" if abs(val) &gt; 0.5 else "black")\nfig.colorbar(im, ax=ax, fraction=0.046, pad=0.04, label=f"correlazione ({METODO})")\nax.set_title(f"Matrice di correlazione - risposta: {target}")\nfig.tight_layout()\nplt.show(block=False)\n\n# --- Correlazioni con la risposta, ordinate per valore assoluto (console) --\nprint(corr[target].drop(target).sort_values(key=abs, ascending=False).round(3))\n\n# --- Output verso Orange ----------------------------------------------------\nout_df = corr.round(3).reset_index().rename(columns={"index": "variabile"})\nout_data = table_from_frame(out_df)', 'filename': None}], 'scriptText': '# Da incollare nel widget Python Script di Orange.\n# Collegamenti: File -&gt; Python Script -&gt; Data Table.\n\nimport numpy as np\nimport pandas as pd\nimport matplotlib.pyplot as plt\nfrom matplotlib.colors import Normalize\nfrom matplotlib.cm import ScalarMappable\nfrom matplotlib.patches import Circle, Rectangle\nfrom Orange.data import (\n    Table, Domain, ContinuousVariable, StringVariable, TimeVariable\n)\n\n# IMPOSTAZIONI\nMETODO = "pearson"                 # In alternativa: "spearman"\nDECIMALI = 2\nMIN_OSSERVAZIONI = 3               # Per ciascuna coppia di variabili\nINCLUDI_TARGET = True\nINCLUDI_META_NUMERICHE = True\nCOLONNE_DA_ESCLUDERE = {"id_progetto"}\nMOSTRA_DIAGONALE = True\nPALETTE = "coolwarm"\nNOME_FIGURA = "Corrplot - triangolare superiore"\n\n\ndef corrplot(matrice, metodo, decimali=2, palette="coolwarm",\n             diagonale=True, nome_figura="Corrplot"):\n    """Correlogramma a bolle realizzato con Matplotlib."""\n    n = len(matrice)\n    valori = matrice.to_numpy(dtype=float)\n    nomi = list(matrice.columns)\n    colori = plt.get_cmap(palette)\n    norma = Normalize(vmin=-1, vmax=1)\n\n    fig = plt.figure(\n        num=nome_figura, figsize=(16, 9), dpi=110,\n        constrained_layout=True\n    )\n    ax = fig.add_subplot(111)\n    ax.set_aspect("equal")\n\n    # Disegna soltanto le celle del triangolo superiore.\n    righe, colonne = np.triu_indices(n, k=0 if diagonale else 1)\n    for i, j in zip(righe, colonne):\n        ax.add_patch(Rectangle(\n            (j - 0.5, i - 0.5), 1, 1,\n            facecolor="white", edgecolor="#e2e7eb", linewidth=0.6\n        ))\n        r = valori[i, j]\n\n        if np.isfinite(r):\n            if i == j:\n                # Diagonale visibile, ma con minore enfasi grafica.\n                ax.add_patch(Circle(\n                    (j, i), radius=0.24,\n                    facecolor="#eef1f4", edgecolor="#d8dee3",\n                    linewidth=0.6\n                ))\n                ax.text(\n                    j, i, f"{r:.{decimali}f}", ha="center", va="center",\n                    fontsize=7.5, color="#788590"\n                )\n            else:\n                # Fuori diagonale: area proporzionale a |r|.\n                ax.add_patch(Circle(\n                    (j, i), radius=0.44 * np.sqrt(abs(r)),\n                    facecolor=colori(norma(r)), edgecolor="none"\n                ))\n                ax.text(\n                    j, i, f"{r:.{decimali}f}", ha="center", va="center",\n                    fontsize=8,\n                    color="white" if abs(r) &gt;= 0.65 else "#24323d"\n                )\n        else:\n            ax.text(j, i, "NA", ha="center", va="center",\n                    fontsize=8, color="#858585")\n\n    ax.set_xlim(-0.5, n - 0.5)\n    ax.set_ylim(n - 0.5, -0.5)\n    ax.set_xticks(np.arange(n))\n    ax.set_yticks(np.arange(n))\n    ax.set_xticklabels(nomi, rotation=45, ha="left",\n                       rotation_mode="anchor", fontsize=9)\n    ax.set_yticklabels(nomi, fontsize=9)\n    ax.xaxis.tick_top()\n    ax.tick_params(axis="both", length=0, pad=7)\n    for bordo in ax.spines.values():\n        bordo.set_visible(False)\n\n    barra = fig.colorbar(\n        ScalarMappable(norm=norma, cmap=colori), ax=ax,\n        fraction=0.035, pad=0.035, shrink=0.75\n    )\n    tacche = np.linspace(-1, 1, 5)\n    barra.set_ticks(tacche)\n    barra.set_ticklabels([f"{x:.{decimali}f}" for x in tacche])\n    barra.set_label("Coefficiente di correlazione", fontsize=10)\n    fig.suptitle(\n        f"Correlazione {metodo.capitalize()} - triangolare superiore",\n        fontsize=17, fontweight="bold"\n    )\n    fig.supxlabel(\n        "Fuori diagonale: area proporzionale a |r| - Blu: negativo; "\n        "rosso: positivo - Diagonale in grigio attenuato",\n        fontsize=9\n    )\n    return fig\n\n# Azzera le uscite anche quando l\'ingresso viene scollegato.\nout_data = None\nout_object = None\nfig = None\nplt.close(NOME_FIGURA)\n\nif in_data is None:\n    print("Collegare un dataset all\'ingresso Data del widget.")\n\nelif len(in_data) &lt; MIN_OSSERVAZIONI:\n    print(f"Servono almeno {MIN_OSSERVAZIONI} righe per il calcolo.")\n\nelse:\n    # Raccoglie le variabili dai diversi ruoli di Orange.\n    variabili = list(in_data.domain.attributes)\n    if INCLUDI_TARGET:\n        variabili += list(in_data.domain.class_vars)\n    if INCLUDI_META_NUMERICHE:\n        variabili += list(in_data.domain.metas)\n\n    # Le variabili categoriche non vengono convertite in codici numerici.\n    numeriche = [\n        v for v in variabili\n        if v.is_continuous\n        and not isinstance(v, TimeVariable)\n        and v.name not in COLONNE_DA_ESCLUDERE\n    ]\n\n    if len(numeriche) &lt; 2:\n        print("Servono almeno due colonne numeriche.")\n\n    else:\n        # Copia i valori: il dataset in ingresso rimane invariato.\n        dati = pd.DataFrame({\n            v.name: np.array(in_data.get_column(v), dtype=float, copy=True)\n            for v in numeriche\n        })\n        dati = dati.replace([np.inf, -np.inf], np.nan)\n\n        # Ogni correlazione usa le righe valide per quella coppia.\n        correlazioni = dati.corr(\n            method=METODO,\n            min_periods=MIN_OSSERVAZIONI\n        ).round(DECIMALI)\n        # Evita etichette come -0.00 dopo l\'arrotondamento.\n        correlazioni = correlazioni.mask(correlazioni.eq(0), 0.0)\n\n        # La parte inferiore viene mascherata con NaN, non con zeri.\n        maschera = np.triu(\n            np.ones(correlazioni.shape, dtype=bool),\n            k=0 if MOSTRA_DIAGONALE else 1\n        )\n        triangolare = correlazioni.where(maschera)\n\n        # Tabella Orange: colonne numeriche e nomi delle righe in Meta.\n        dominio = Domain(\n            attributes=[\n                ContinuousVariable(nome, number_of_decimals=DECIMALI)\n                for nome in triangolare.columns\n            ],\n            metas=[StringVariable("Variabile")]\n        )\n        out_data = Table.from_numpy(\n            dominio,\n            X=triangolare.to_numpy(dtype=float),\n            metas=np.array(triangolare.index, dtype=object).reshape(-1, 1)\n        )\n        out_data.name = f"Correlazione {METODO} - triangolare superiore"\n\n        # L\'uscita Object contiene anche il DataFrame pandas.\n        out_object = triangolare\n\n        fig = corrplot(\n            triangolare, metodo=METODO, decimali=DECIMALI,\n            palette=PALETTE, diagonale=MOSTRA_DIAGONALE,\n            nome_figura=NOME_FIGURA\n        )\n        fig.canvas.draw_idle()\n        plt.show(block=False)\n\n        print(f"Metodo: {METODO}; righe in ingresso: {len(in_data)}")\n        print(f"Matrice: {len(numeriche)} x {len(numeriche)}")\n        print("Colonne incluse: " + ", ".join(correlazioni.columns))\n        print("Collegare l\'uscita Data a Data Table per vedere la matrice.")\n        print("Il corrplot viene visualizzato in una finestra Matplotlib.")\n\n        if correlazioni.isna().any().any():\n            print(\n                "Alcune correlazioni non sono definite: controllare "\n                "colonne costanti e numero di osservazioni valide."\n            )\n', 'splitterState': b'\x00\x00\x00\xff\x00\x00\x00\x01\x00\x00\x00\x02\x00\x00\x00\x9f\x00\x00\x00`\x01\xff\xff\xff\xff\x01\x00\x00\x00\x02\x00', 'vimModeEnabled': False, '__version__': 2}</properties>
